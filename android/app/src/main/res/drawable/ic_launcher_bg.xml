<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background (108dp canvas): black, with soft teal light from
     the top-left and a smaller yellow glow bottom-right, like the website's
     background blobs. Yellow sits over black only, so it stays gold. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#000000" android:pathData="M0,0h108v108h-108z" />
    <!-- main teal blob -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="32" android:centerY="30" android:gradientRadius="60">
                <item android:offset="0" android:color="#FF17A2B8" />
                <item android:offset="0.4" android:color="#E00E7490" />
                <item android:offset="0.75" android:color="#40032A33" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- brighter teal highlight, top-right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="76" android:centerY="22" android:gradientRadius="30">
                <item android:offset="0" android:color="#8017B3C2" />
                <item android:offset="1" android:color="#0017B3C2" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- yellow glow, bottom-right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="84" android:centerY="86" android:gradientRadius="46">
                <item android:offset="0" android:color="#FFFACC15" />
                <item android:offset="0.5" android:color="#80C98500" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
