# Strava API app from https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: strava.local
VITE_STRAVA_CLIENT_ID=

# Only used by scripts/ and the local token server. No VITE_ prefix, so Vite
# can never bundle it into the app. In production it lives in Vercel.
STRAVA_CLIENT_SECRET=

# Token server (web/ deployed on Vercel) that completes Strava sign-in.
VITE_TOKEN_API_URL=
